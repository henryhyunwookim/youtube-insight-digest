# ===========================================================================
# YouTube Insight Digest - Environment Variables & Cloud Configuration
# ===========================================================================
#
# NOTE: This project is built on a Cloud-Native, Multi-PC Portable Architecture.
# All sensitive secrets (GEMINI_API_KEY, OAuth token, client credentials) are
# managed dynamically via Google Cloud Secret Manager.
# State (processed videos) and execution logs are managed via Google Cloud Storage (GCS).
#
# A local .env file is OPTIONAL and only needed if overriding cloud defaults.
#

# 1. Google Cloud Project & Storage Settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-northeast1
SERVICE_NAME=youtube-insight-digest
# GCS Bucket for persistent state (defaults to {GCP_PROJECT_ID}-monitor-data)
GCS_BUCKET_NAME=

# 2. Secret Manager Resolution (Optional local overrides)
# If left blank, these are auto-resolved from Google Cloud Secret Manager:
# - 'gemini-api-key'
# - 'youtube-insight-token' (Gmail user OAuth token)
# - 'youtube-insight-credentials' (OAuth client credentials)
# - 'youtube-insight-recipient-email'
GEMINI_API_KEY=
RECIPIENT_EMAIL=your_email@example.com
RECIPIENT_NAME="AI Practitioner"

# 3. Model & Operational Settings
GEMINI_MODEL=gemini-3.8-flash
TIMEZONE=Asia/Tokyo
DEFAULT_LOOKBACK_HOURS=24

# ===========================================================================
# YouTube Insight Digest - Environment Variables Configuration
# ===========================================================================

# 1. Google Gemini API & Model Configuration
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Model selection: e.g., gemini-3.8-flash (default, powerful & cost-effective), gemini-3.5-flash, or gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# 2. Email Delivery Configuration
# Your destination email address where the daily digest will be delivered
RECIPIENT_EMAIL=your_email@example.com
RECIPIENT_NAME="AI Practitioner"

# 3. Timezone & Operational Settings
# System operates on Japan Standard Time (JST)
TIMEZONE=Asia/Tokyo

# Lookback window in hours when scanning for newly published videos (default: 24)
DEFAULT_LOOKBACK_HOURS=24

# 4. Optional Cloud & Serverless Settings (Leave blank for local workstation use)
GCP_PROJECT_ID=
GCP_REGION=asia-northeast1
SERVICE_NAME=youtube-insight-digest
